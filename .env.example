# Configuracion de la base de datos (Render Postgres)
# Opcion A: variables individuales (como las da Render al conectar la BD al servicio)
PGHOST=hostname
PGPORT=5432
PGDATABASE=nombre_bd
PGUSER=usuario
PGPASSWORD=contrasena

# Opcion B: URL unica (alternativa a la Opcion A; solo una de las dos es necesaria)
# DATABASE_URL=postgres://usuario:contrasena@host:5432/nombre_bd

# Opcional: 'disable' para desactivar SSL en hosts remotos
# PGSSLMODE=disable

# Servidor
PORT=3000
SESSION_SECRET=cambia_esto_en_produccion